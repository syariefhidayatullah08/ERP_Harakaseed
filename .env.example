# Lokal: jalankan `vercel env pull` untuk mengisi DATABASE_URL dkk. otomatis ke .env.local,
# lalu tambahkan variabel di bawah ini yang dibutuhkan. Di Vercel, isi lewat `vercel env add` / dashboard.

# --- Database (Neon Postgres, diisi otomatis oleh integrasi Vercel) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Opsional untuk lokal: pakai schema terpisah agar tidak mengubah data produksi
# DB_SCHEMA=dev

# --- Login awal (hanya dipakai saat database pertama kali dibuat) ---
ADMIN_EMAIL=ptbenihharakasejahter@gmail.com
ADMIN_PASSWORD=ganti-kata-sandi-ini

# Rahasia untuk menandatangani cookie sesi. Wajib di Vercel. Isi string acak panjang.
SESSION_SECRET=ganti-dengan-string-acak-panjang

# --- Koneksi email ---
# Gmail: pakai App Password (myaccount.google.com/apppasswords), bukan kata sandi biasa.
EMAIL_USER=ptbenihharakasejahter@gmail.com
EMAIL_PASS=
# Opsional: nama pengirim
# EMAIL_FROM="HARAKA SEED <ptbenihharakasejahter@gmail.com>"

# Isi hanya jika TIDAK memakai Gmail (mis. email domain @harakaseeds.com di Zoho / cPanel / Outlook)
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# IMAP_HOST=imap.zoho.com
# IMAP_PORT=993

# Isi 0 agar database baru TIDAK diisi data contoh
# SEED_DEMO=0
