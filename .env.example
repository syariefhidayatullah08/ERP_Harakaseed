# Salin file ini menjadi .env.local lalu isi nilainya.

# --- Login awal (hanya dipakai saat database pertama kali dibuat) ---
ADMIN_EMAIL=admin@harakaseeds.com
ADMIN_PASSWORD=ganti-kata-sandi-ini

# Rahasia untuk menandatangani cookie sesi. Isi string acak panjang.
SESSION_SECRET=ganti-dengan-string-acak-panjang

# --- Koneksi email ---
# Gmail: pakai App Password (myaccount.google.com/apppasswords), bukan kata sandi biasa.
EMAIL_USER=ptbenihharakasejahtera@gmail.com
EMAIL_PASS=
# Opsional: nama pengirim
# EMAIL_FROM="HARAKA SEED <ptbenihharakasejahtera@gmail.com>"

# Isi hanya jika TIDAK memakai Gmail (mis. email domain @harakaseeds.com di Zoho / cPanel / Outlook)
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# IMAP_HOST=imap.zoho.com
# IMAP_PORT=993

# --- Lainnya ---
# Isi 0 agar database baru TIDAK diisi data contoh
# SEED_DEMO=0
# Lokasi file database (default: ./data/haraka.db)
# DATABASE_PATH=
